# ───────── Browser (VITE_*) ─────────
# Optional custom RPCs. Mainnet public RPC is rate-limited and often blocked in browsers: use a provider (Helius, QuickNode, Triton...).
VITE_RPC_DEVNET=https://api.devnet.solana.com
VITE_RPC_MAINNET=
# Only if the API lives on another origin (default: same origin /api)
VITE_API_BASE=
# UI preview with NO on-chain activity (Math.random). Never enable in production.
VITE_DEMO_MODE=false

# ───────── Server (never prefix with VITE_) ─────────
# House wallet that receives bets and pays winners. base58 secret key OR JSON byte array. FUND THIS WALLET on each network.
HOUSE_SECRET_KEY=
# 32+ random bytes as hex:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLIP_SECRET=
# Mainnet moves real money; it is OFF unless you set this to "true".
MAINNET_ENABLED=false
RPC_DEVNET=https://api.devnet.solana.com
RPC_MAINNET=
MIN_BET_SOL_DEVNET=0.01
MAX_BET_SOL_DEVNET=5
MIN_BET_SOL_MAINNET=0.01
MAX_BET_SOL_MAINNET=1
# Replay / double-payout protection store (REQUIRED in production). Vercel KV / Upstash Redis REST:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local dev only (single process, not safe for serverless):
ALLOW_MEMORY_STORE=false
